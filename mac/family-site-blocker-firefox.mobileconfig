<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadContent</key>
			<dict>
				<key>org.mozilla.firefox</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>EnterprisePoliciesEnabled</key>
								<true/>
								<key>Extensions</key>
								<dict>
									<key>Install</key>
									<array>
										<string>https://adviseworn.github.io/family-site-blocker-updates/family-site-blocker.xpi</string>
									</array>
									<key>Locked</key>
									<array>
										<string>family-site-blocker@parental-controls.local</string>
									</array>
								</dict>
								<key>ExtensionUpdate</key>
								<true/>
								<key>DisablePrivateBrowsing</key>
								<true/>
								<key>DisableSafeMode</key>
								<true/>
								<key>BlockAboutConfig</key>
								<true/>
								<key>DisableProfileRefresh</key>
								<true/>
								<key>Preferences</key>
								<dict>
									<key>extensions.dnr.enabled</key>
									<dict>
										<key>Value</key>
										<true/>
										<key>Status</key>
										<string>locked</string>
									</dict>
								</dict>
								<key>WebsiteFilter</key>
								<dict>
									<key>Block</key>
									<array>
										<string>*://*.exampleadultsite.com/*</string>
										<string>*://*.pornhub.com/*</string>
										<string>*://*.xvideos.com/*</string>
										<string>*://*.xnxx.com/*</string>
										<string>*://*.xhamster.com/*</string>
										<string>*://*.redtube.com/*</string>
										<string>*://*.youporn.com/*</string>
										<string>*://*.spankbang.com/*</string>
										<string>*://*.eporner.com/*</string>
										<string>*://*.tube8.com/*</string>
										<string>*://*.tnaflix.com/*</string>
										<string>*://*.beeg.com/*</string>
										<string>*://*.motherless.com/*</string>
										<string>*://*.brazzers.com/*</string>
										<string>*://*.chaturbate.com/*</string>
										<string>*://*.stripchat.com/*</string>
										<string>*://*.bongacams.com/*</string>
										<string>*://*.livejasmin.com/*</string>
										<string>*://*.cam4.com/*</string>
										<string>*://*.onlyfans.com/*</string>
									</array>
								</dict>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
			<key>PayloadDisplayName</key>
			<string>Firefox settings</string>
			<key>PayloadIdentifier</key>
			<string>local.parental-controls.family-site-blocker.firefox.settings</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>27DF5EE7-2FC4-49DA-8FBF-D509708E1522</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Keeps the Family Site Blocker add-on installed and switched on in Firefox, for every account on this Mac. Firefox installs the newest signed version from https://adviseworn.github.io/family-site-blocker-updates/family-site-blocker.xpi, keeps it up to date, and nobody can turn it off or remove it there. Firefox also gets its own copy of the add-on’s built-in list of sites, which keeps blocking them when add-ons don’t run, as in Troubleshoot Mode. Private windows, Troubleshoot Mode from Firefox’s menus, about:config and Refresh Firefox, which could get round it, are turned off. Settings that other programs, such as another blocker, give Firefox for their own add-ons stay in force. Only an administrator can remove this profile.</string>
	<key>PayloadDisplayName</key>
	<string>Family Site Blocker for Firefox</string>
	<key>PayloadIdentifier</key>
	<string>local.parental-controls.family-site-blocker.firefox</string>
	<key>PayloadOrganization</key>
	<string>Family Site Blocker</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>C3B0C6B7-3BE0-4536-A299-E2F9BF95B6E2</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
