{
  "name": "family-site-blocker",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Chrome, Edge, Brave and Firefox extension that blocks adult websites",
  "scripts": {
    "build": "node scripts/build-rules.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package:firefox": "node scripts/package-firefox.mjs",
    "package:signed": "node scripts/package-signed.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.e2e.mjs",
    "test:firefox": "node --test test/firefox.e2e.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:firefox",
    "firefox-lock": "node scripts/firefox-lock.mjs",
    "test:firefox-lock": "node --test test/firefox-lock.e2e.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=18"
  }
}
