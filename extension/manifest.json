{
  "manifest_version": 3,
  "name": "Family Site Blocker",
  "version": "1.4.1",
  "description": "Blocks adult websites. Starts with a built-in list, lets you add your own, notes blocked attempts, and can test itself.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "family-site-blocker@parental-controls.local",
      "strict_min_version": "140.0",
      "update_url": "https://adviseworn.github.io/family-site-blocker-updates/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "webRequest",
    "history",
    "bookmarks"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Family Site Blocker settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult-1",
        "enabled": true,
        "path": "rules/adult-1.json"
      },
      {
        "id": "adult-2",
        "enabled": true,
        "path": "rules/adult-2.json"
      },
      {
        "id": "safe-search",
        "enabled": true,
        "path": "rules/safe-search.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
